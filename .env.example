# ---- HTTP ----
PORT=3000

# ---- API auth (single shared key; see common/api-key.guard.ts) ----
API_KEY=dev-secret-key

# ---- PostgreSQL ----
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=flowforge
DATABASE_PASSWORD=flowforge
DATABASE_NAME=flowforge
# Auto-create schema from entities on boot (fine for a demo; use migrations in prod)
DATABASE_SYNC=true

# ---- Redis / BullMQ ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ---- Engine ----
# Per-step retry attempts (BullMQ). 1 = no retry.
STEP_MAX_ATTEMPTS=3
# Base backoff in ms (exponential). attempt N waits BACKOFF * 2^(N-1).
STEP_BACKOFF_MS=1000
# Number of concurrent step jobs a worker processes.
ENGINE_CONCURRENCY=5

# ---- LLM (Google Gemini free tier) ----
# Leave empty to run in offline MOCK mode (deterministic, no network).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
